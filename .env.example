# Database — local dev uses SQLite (no Docker required)
# API reads this path from server/ → prisma/dev.db
DATABASE_URL="file:../prisma/dev.db"

# Production / staging (PostgreSQL) — use schema.postgresql.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/licp?schema=public"

# API
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Auth secrets (generate unique values for production)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_PENDING_SECRET="change-me-pending-secret-min-32-chars"

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PENDING_TOKEN_MINUTES=10

# Email — required for invitations, verification, password reset (production)
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_ENCRYPTION=tls
# Use a Google App Password (not your normal password): https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LICP <noreply@yourdomain.com>"

# Dev: set USE_ETHEREAL_EMAIL=false to disable Ethereal test mail and use only real SMTP
# USE_ETHEREAL_EMAIL=false

# MFA is required. Only set SKIP_LOGIN_MFA=true for automated UAT scripts.
SKIP_LOGIN_MFA=false

# Dev auth helpers (/auth/mfa/dev-code) — useful with MFA enabled for demo accounts
ENABLE_DEV_AUTH_HELPERS=true

# Frontend — demo login panel (dev builds always show it; set true for staging demos)
# VITE_ENABLE_DEMO_LOGIN=true

# Optional LLM for AI Legal Intelligence (recommended).
# Platform search retrieves LICP records as context; the LLM writes the answer (RAG).
# If no key is set, AI falls back to a structured search-result summary.
# Free option (recommended): Groq — no credit card, OpenAI-compatible
# Create a key at https://console.groq.com/keys then set:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Paid option: OpenAI (used only if GROQ_API_KEY is not set)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# Optional overrides for any OpenAI-compatible provider:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Frontend API URL for production builds (Vercel)
# Must include /api/v1 — example after Render deploy:
# VITE_API_URL=https://licp-api.onrender.com/api/v1
# VITE_ENABLE_DEMO_LOGIN=true

# Split deploy (Render API + Vercel web):
# CLIENT_ORIGIN=https://your-app.vercel.app
# CLIENT_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# COOKIE_SAME_SITE=none
# SERVE_FRONTEND=false
# VERCEL_CORS=true
