@startuml LICP_Use_Case_Simple
' Compact overview (Figure 2 alternative) — current LICP

scale 0.85
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle

left to right direction

actor "Administrator" as Admin
actor "Compliance\nOfficer" as CO
actor "Legal\nPractitioner" as LP
actor "Manager" as Mgr
actor "External\nIntegrations" as Ext

rectangle "LICP System" {
  usecase "Login / MFA /\nInvitation onboarding" as UC1
  usecase "Manage users &\naccess control" as UC2
  usecase "Track compliance\nobligations & evidence" as UC3
  usecase "Review regulatory\nupdates" as UC4
  usecase "Legal knowledge &\ncontract lifecycle" as UC5
  usecase "Analytics &\nprofessional PDF reports" as UC6
  usecase "AI legal intelligence" as UC7
  usecase "Configure &\nsync integrations" as UC8
  usecase "Notifications &\nrole dashboards" as UC9
  usecase "Security audit\n& system settings" as UC10
}

Admin --> UC1
Admin --> UC2
Admin --> UC6
Admin --> UC8
Admin --> UC9
Admin --> UC10

CO --> UC1
CO --> UC3
CO --> UC4
CO --> UC5
CO --> UC6
CO --> UC7
CO --> UC9

LP --> UC1
LP --> UC4
LP --> UC5
LP --> UC7
LP --> UC9

Mgr --> UC1
Mgr --> UC3
Mgr --> UC4
Mgr --> UC5
Mgr --> UC6
Mgr --> UC7
Mgr --> UC9

Ext --> UC8

@enduml
